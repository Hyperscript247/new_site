generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  description String?
  type        CategoryType @default(COURSE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  courses     Course[]
  blogPosts   BlogPost[]
}

enum CategoryType {
  COURSE
  BLOG
}

model Course {
  id            String          @id @default(cuid())
  title         String
  description   String
  categoryId    String
  category      Category        @relation(fields: [categoryId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  registrations Registration[]
  roadmap       CourseRoadmap?
}

model Registration {
  id                  String                 @id @default(cuid())
  fullName            String
  email               String
  phone               String
  location            String
  availability        String
  experienceLevel     String
  courseId            String
  createdAt           DateTime               @default(now())
  status              String                 @default("Pending")
  courseProgress      Int                    @default(0)
  paymentStatus       String                 @default("Unpaid")
  course              Course                 @relation(fields: [courseId], references: [id])
  completedMilestones MilestoneCompletion[]
}

model Admin {
  id        String     @id @default(cuid())
  username  String     @unique
  password  String
  fullName  String?
  bio       String?    @db.Text
  avatar    String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  blogPosts BlogPost[]
}

model CommunityMember {
  id                     String   @id @default(cuid())
  fullName               String
  email                  String
  phone                  String
  dateOfBirth            String
  gender                 String?
  profession             String
  linkedinProfile        String?
  areasOfInterest        String[]
  supportSeeking         String[]
  preferredEvents        String
  willingToVolunteer     Boolean  @default(false)
  areasToSupport         String[]
  howDidYouHear          String?
  agreeToTerms           Boolean  @default(false)
  agreeToCommunications  Boolean  @default(false)
  status                 String   @default("Pending")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Album {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      Image[]
}

model Image {
  id            String   @id @default(cuid())
  title         String
  description   String?
  cloudinaryId  String   @unique
  url           String
  thumbnailUrl  String
  width         Int
  height        Int
  format        String
  size          Int
  sortOrder     Int      @default(0)
  albumId       String
  album         Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([albumId, sortOrder])
}

model CourseRoadmap {
  id          String      @id @default(cuid())
  courseId    String      @unique
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  course      Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  milestones  Milestone[]
}

model Milestone {
  id              String                 @id @default(cuid())
  roadmapId       String
  title           String
  description     String
  type            String                 @default("lesson")
  durationWeeks   Int                    @default(1)
  sortOrder       Int                    @default(0)
  prerequisiteIds String[]               @default([])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  roadmap         CourseRoadmap          @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  completions     MilestoneCompletion[]

  @@index([roadmapId, sortOrder])
}

model MilestoneCompletion {
  id             String       @id @default(cuid())
  registrationId String
  milestoneId    String
  completedAt    DateTime     @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  milestone      Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([registrationId, milestoneId])
  @@index([registrationId])
  @@index([milestoneId])
}

model BlogPost {
  id                    String      @id @default(cuid())
  title                 String
  slug                  String      @unique
  excerpt               String?     @db.Text
  content               String      @db.Text
  featuredImageUrl      String?
  featuredImagePublicId String?
  featuredImageAlt      String?
  categoryId            String?
  category              Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  authorId              String?
  author                Admin?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  status                PostStatus  @default(DRAFT)
  publishedAt           DateTime?
  scheduledAt           DateTime?
  viewCount             Int         @default(0)
  readingTime           Int?

  // SEO fields
  metaTitle             String?
  metaDescription       String?     @db.Text
  keywords              String[]    @default([])
  ogImage               String?

  // Tags and features
  tags                  String[]    @default([])
  isFeatured            Boolean     @default(false)
  allowComments         Boolean     @default(false)

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([slug])
  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
  @@index([authorId])
  @@index([isFeatured])
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
