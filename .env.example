# ====================================
# DATABASE CONFIGURATION
# ====================================
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/hyperscript_db?schema=public"

# ====================================
# EMAIL CONFIGURATION - ZEPTOMAIL (Primary)
# ====================================
# FEATURE 4: ZeptoMail Integration for all system emails
# REQUIRED: Set up ZeptoMail account and configure these values
# ZeptoMail is Zoho's transactional email service - perfect for system emails

# ZeptoMail REST API Configuration
# Get your API key from: https://www.zoho.com/zeptomail/ > Settings > API
ZEPTOMAIL_API_KEY="your-zeptomail-api-key"  # From ZeptoMail Account > API
ZEPTOMAIL_API_URL="https://api.zeptomail.com/v1.1/email"  # REST API endpoint

# Email Sender Configuration
EMAIL_FROM_NAME="Hyperscript"
EMAIL_FROM_ADDRESS="noreply@hyperscript.com"  # Must be verified in ZeptoMail
EMAIL_REPLY_TO="info@hyperscript.com"

# Admin Notification Emails
ADMIN_EMAIL="admin@hyperscript.com"  # Receives contact form, registrations
COMMUNITY_EMAIL="community@hyperscript.com"  # Community registrations

# ====================================
# EMAIL CONFIGURATION - LEGACY (Fallback)
# ====================================
# EmailJS Configuration (Currently used in contact form - can be replaced)
NEXT_PUBLIC_EMAILJS_SERVICE_ID="service_f58sgyf"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID="template_pv2id5n"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="0uyq2X_-JcvzHkeFc"

# Alternative Email Services (Optional)
# OPTION 1: Resend
# RESEND_API_KEY="re_your_resend_api_key"
# EMAIL_FROM="Hyperscript <onboarding@hyperscript.ng>"

# OPTION 2: Other SMTP (Gmail, Mailgun, SendGrid, etc.)
# Configure SMTP settings above with your provider details

# ====================================
# CLOUDINARY CONFIGURATION
# ====================================
# FEATURE 2 & 3: Image Gallery and Blog Featured Images
# REQUIRED: Create Cloudinary account at cloudinary.com

# Cloudinary Account Credentials
CLOUDINARY_CLOUD_NAME="your-cloud-name"  # From Cloudinary dashboard
CLOUDINARY_API_KEY="your-api-key"  # From Cloudinary dashboard
CLOUDINARY_API_SECRET="your-api-secret"  # From Cloudinary dashboard

# Cloudinary Upload Configuration
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="your-upload-preset"  # Create in Upload Settings

# Optional: Cloudinary Folder Structure
# CLOUDINARY_GALLERY_FOLDER="hyperscript/gallery"
# CLOUDINARY_BLOG_FOLDER="hyperscript/blog"

# ====================================
# SESSION & SECURITY
# ====================================
# Session Secret (Generate a random secure string)
SESSION_SECRET="your-secure-random-string-change-this-in-production"

# ====================================
# OPTIONAL FEATURES
# ====================================
# Analytics (Future Integration)
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Error Tracking (Future Integration)
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"

